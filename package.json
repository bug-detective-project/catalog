{
  "name": "@bug-detective/catalog",
  "version": "1.1.0",
  "description": "Bug Detective projects catalog, content contract and bd CLI",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=26.12.1"
  },
  "exports": {
    "./contract": {
      "types": "./dist/contract/index.d.ts",
      "default": "./dist/contract/index.js"
    }
  },
  "bin": {
    "bd": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run check:action-pins && npm test && npm run format:check",
    "check:action-pins": "node tools/check-action-pins.mjs"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "tar-stream": "3.2.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/tar-stream": "3.1.5",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
